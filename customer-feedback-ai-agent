      }
    }

    /* =====================================================================
       14. FOCUS VISIBLE GLOBAL
       ===================================================================== */
    :focus-visible {
      outline: 2px solid var(--color-border-focus);
      outline-offset: 2px;
    }

    /* Remove default focus for mouse users on elements that set custom styles */
    .btn-analyze:focus:not(:focus-visible),
    .demo-trigger:focus:not(:focus-visible) {
      outline: none;
    }
