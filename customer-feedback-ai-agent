  <script>
    (function () {
      "use strict";

      var API_URL = "https://api.anthropic.com/v1/messages";
      var MODEL = "claude-sonnet-4-6";

      var CATEGORY_LABELS = {
        product: "Product",
        service: "Service",
        delivery: "Delivery",
        other: "Other"
      };

      var DEMO_META = {
        positive: { category: "product" },
        neutral: { category: "service" },
        negative: { category: "delivery" }
      };

      function $(id) { return document.getElementById(id); }

      function escapeHtml(str) {
        return String(str)
          .replace(/&/g, "&amp;")
          .replace(/</g, "&lt;")
          .replace(/>/g, "&gt;")
          .replace(/"/g, "&quot;")
          .replace(/'/g, "&#039;");
      }

      function clampConfidence(n) {
        n = Math.round(Number(n));
        if (isNaN(n)) return 0;
        return Math.max(0, Math.min(100, n));
      }

      function capitalize(s) {
        return s.charAt(0).toUpperCase() + s.slice(1);
      }

      function formatToday() {
        return new Date().toLocaleDateString("en-GB", {
          day: "2-digit",
          month: "short",
          year: "numeric"
        });
      }

      function getSelectedCategory() {
        var checked = document.querySelector('input[name="category"]:checked');
        return checked ? checked.value : "";
      }

      function clearDemoActive() {
        document.querySelectorAll(".demo-trigger").forEach(function (btn) {
          btn.classList.remove("active");
        });
      }

      function showFormError(show) {
        var textarea = $("feedback-text");
        var err = $("feedback-error");
        textarea.classList.toggle("invalid", show);
        err.classList.toggle("visible", show);
      }

      function showResultError(message) {
        var el = $("result-error");
        el.textContent = message;
        el.classList.add("visible");
      }

      function clearResultError() {
        var el = $("result-error");
        el.textContent = "";
        el.classList.remove("visible");
      }

      function setLoading(isLoading) {
        var panel = $("results-panel");
        panel.classList.toggle("is-loading", isLoading);
      }

      function buildPrompt(text, category) {
        return (
          "You are a customer feedback analyst. Analyze the customer feedback below and " +
          "respond with ONLY a raw JSON object — no markdown code fences, no preamble, no " +
          "explanation, nothing outside the JSON. Match this exact schema:\n\n" +
          "{\n" +
          '  "sentiment": "positive" | "neutral" | "negative",\n' +
          '  "confidence": <integer 0-100>,\n' +
          '  "scenario": "<a short 2-4 word label describing the type of feedback, e.g. ' +
          '\'Product Review\' or \'Delivery Complaint\'>",\n' +
          '  "topics": ["<short topic 1>", "<short topic 2>", "... up to 5 short topics>"],\n' +
          '  "summary": "<a 2-4 sentence analysis summary explaining the sentiment and a ' +
          'recommended next action>"\n' +
          "}\n\n" +
          "Category hint provided by the user (may be blank): " + (category || "none") + "\n\n" +
          'Customer feedback:\n"""\n' + text + '\n"""\n\n' +
          "Respond with the JSON object only."
        );
      }

      function renderResult(result) {
        var card = $("result-card");
        var sentiment = ["positive", "neutral", "negative"].indexOf(result.sentiment) !== -1
          ? result.sentiment
          : "neutral";
        var confidence = clampConfidence(result.confidence);
        var scenario = result.scenario ? escapeHtml(String(result.scenario)) : "";
        var topics = Array.isArray(result.topics) ? result.topics.slice(0, 5) : [];
        var summary = result.summary ? escapeHtml(String(result.summary)) : "";

        var topicsHtml = topics.map(function (t) {
          return '<li><span class="topic-pill"><span class="topic-pill-dot" aria-hidden="true"></span>' +
            escapeHtml(String(t)) + "</span></li>";
        }).join("");

        card.className = "result-card active " + sentiment;
        card.innerHTML =
          '<div class="sentiment-row">' +
            '<span class="sentiment-badge ' + sentiment + '">' +
              '<span class="sentiment-dot" aria-hidden="true"></span>' +
              capitalize(sentiment) +
            "</span>" +
            (scenario ? '<span class="result-scenario">' + scenario + "</span>" : "") +
          "</div>" +
          '<div class="result-section">' +
            '<p class="result-section-label">Confidence Score</p>' +
            '<div class="score-row ' + sentiment + '">' +
              '<div class="score-bar" role="progressbar" aria-valuenow="' + confidence +
                '" aria-valuemin="0" aria-valuemax="100" aria-label="Confidence ' + confidence + '%">' +
                '<div class="score-fill" style="width: ' + confidence + '%;"></div>' +
              "</div>" +
              '<span class="score-value">' + confidence + "%</span>" +
            "</div>" +
          "</div>" +
          (topics.length ? (
            '<div class="result-section">' +
              '<p class="result-section-label">Key Topics</p>' +
              '<ul class="topics-list" aria-label="Extracted key topics">' + topicsHtml + "</ul>" +
            "</div>"
          ) : "") +
          (summary ? (
            '<div class="result-section">' +
              '<p class="result-section-label">Analysis Summary</p>' +
              '<p class="summary-text">' + summary + "</p>" +
            "</div>"
          ) : "");
      }

      function addHistoryRow(result, text, category) {
        var tbody = $("history-body");
        var sentiment = ["positive", "neutral", "negative"].indexOf(result.sentiment) !== -1
          ? result.sentiment
          : "neutral";
        var confidence = clampConfidence(result.confidence);
        var catLabel = CATEGORY_LABELS[category] || "General";
        var preview = text.length > 140 ? text.slice(0, 140).trim() + "…" : text;

        var tr = document.createElement("tr");
        tr.innerHTML =
          '<td class="td-date">' + formatToday() + "</td>" +
          '<td class="td-category"><span class="category-tag">' + escapeHtml(catLabel) + "</span></td>" +
          '<td class="td-feedback"><span class="feedback-preview">' + escapeHtml(preview) + "</span></td>" +
          "<td>" +
            '<span class="sentiment-badge ' + sentiment + '">' +
              '<span class="sentiment-dot" aria-hidden="true"></span>' + capitalize(sentiment) +
            "</span>" +
          "</td>" +
          '<td class="td-confidence">' +
            '<div class="mini-score-wrap">' +
              '<div class="mini-bar"><div class="mini-fill ' + sentiment + '" style="width:' + confidence + '%"></div></div>' +
              '<span class="mini-pct ' + sentiment + '">' + confidence + "%</span>" +
            "</div>" +
          "</td>";

        tbody.insertBefore(tr, tbody.firstChild);

        var count = tbody.querySelectorAll("tr").length;
        [$("history-count"), $("nav-history-count")].forEach(function (el) {
          if (!el) return;
          el.textContent = String(count);
          el.setAttribute("aria-label", count + " history entries");
        });
      }

      async function analyze(text, category) {
        clearResultError();
        setLoading(true);
        $("results-panel").classList.remove("has-result");

        try {
          var response = await fetch(API_URL, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              model: MODEL,
              max_tokens: 1000,
              messages: [{ role: "user", content: buildPrompt(text, category) }]
            })
          });

          if (!response.ok) {
            throw new Error("The analysis service returned an error (status " + response.status + "). Please try again.");
          }

          var data = await response.json();
          var textBlocks = (data.content || [])
            .filter(function (block) { return block.type === "text"; })
            .map(function (block) { return block.text; })
            .join("\n");

          var cleaned = textBlocks.replace(/```json/g, "").replace(/```/g, "").trim();

          var result;
          try {
            result = JSON.parse(cleaned);
          } catch (parseErr) {
            throw new Error("Couldn't parse the analysis response. Please try again.");
          }

          if (!result || ["positive", "neutral", "negative"].indexOf(result.sentiment) === -1) {
            throw new Error("The analysis response was in an unexpected format. Please try again.");
          }

          renderResult(result);
          addHistoryRow(result, text, category);
          $("results-panel").classList.add("has-result");
        } catch (err) {
          showResultError(err && err.message ? err.message : "Something went wrong while analyzing this feedback. Please try again.");
        } finally {
          setLoading(false);
        }
      }

      // Form submit
      $("feedback-form").addEventListener("submit", function (e) {
        e.preventDefault();
        var textarea = $("feedback-text");
        var text = textarea.value.trim();

        if (text.length < 20) {
          showFormError(true);
          textarea.focus();
          return;
        }
        showFormError(false);
        clearDemoActive();

        analyze(text, getSelectedCategory());
      });

      $("feedback-text").addEventListener("input", function () {
        if (this.value.trim().length >= 20) showFormError(false);
      });

      // Demo triggers
      document.querySelectorAll(".demo-trigger").forEach(function (btn) {
        btn.addEventListener("click", function () {
          var key = btn.getAttribute("data-demo");
          var sampleEl = document.querySelector(".demo-text-" + key);
          if (!sampleEl) return;

          var sampleText = sampleEl.textContent.replace(/\s+/g, " ").trim().replace(/^[""]|[""]$/g, "");
          var meta = DEMO_META[key] || {};

          $("feedback-text").value = sampleText;
          showFormError(false);

          if (meta.category) {
            var radio = document.getElementById("cat-" + meta.category);
            if (radio) radio.checked = true;
          }

          clearDemoActive();
          btn.classList.add("active");

          analyze(sampleText, meta.category || "");
        });
      });
    })();
  </script>

</body>
</html>
