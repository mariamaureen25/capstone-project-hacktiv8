<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Feedback Sentinel — analyze customer feedback for sentiment, key topics, confidence scores, and actionable summaries." />
  <title>Feedback Sentinel — Customer Sentiment Analyzer</title>
  <style>
    /* =====================================================================
       1. DESIGN TOKENS
       ===================================================================== */
    :root {
      --color-bg:               #f8f9fa;
      --color-surface:          #ffffff;
      --color-border:           #dee2e6;
      --color-border-focus:     #0d6efd;
      --color-text-primary:     #212529;
      --color-text-secondary:   #6c757d;
      --color-text-inverse:     #ffffff;
      --color-positive:         #198754;
      --color-positive-bg:      #d1e7dd;
      --color-positive-text:    #0a3622;
      --color-neutral:          #b45309;
      --color-neutral-bg:       #fef3c7;
      --color-neutral-text:     #451a03;
      --color-negative:         #dc3545;
      --color-negative-bg:      #f8d7da;
      --color-negative-text:    #58151c;
      --color-accent:           #0d6efd;
      --color-accent-hover:     #0b5ed7;
      --color-accent-active:    #0a58ca;
      --color-row-stripe:       #f1f3f5;
      --color-row-hover:        #e9ecef;
      --color-skip-bg:          #0d6efd;

      --font-stack: -apple-system, "Segoe UI", system-ui, "Helvetica Neue", Arial, sans-serif;
      --font-mono:  ui-monospace, "SFMono-Regular", Consolas, "Liberation Mono", monospace;

      --radius-sm:  4px;
      --radius:     8px;
      --radius-lg:  12px;
      --radius-pill: 999px;

      --shadow-sm:  0 1px 3px rgba(0,0,0,.08), 0 1px 2px rgba(0,0,0,.05);
      --shadow:     0 2px 8px rgba(0,0,0,.08), 0 1px 4px rgba(0,0,0,.06);

      --space-xs:   4px;
      --space-sm:   8px;
      --space-md:   16px;
      --space-lg:   24px;
      --space-xl:   32px;
      --space-2xl:  48px;

      --transition-fast: 0.15s ease;
      --transition:      0.25s ease;
    }

    /* =====================================================================
       2. RESET & BASE
       ===================================================================== */
    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html { scroll-behavior: smooth; }

    body {
      font-family: var(--font-stack);
      font-size: 15px;
      line-height: 1.6;
      color: var(--color-text-primary);
      background: var(--color-bg);
      min-height: 100vh;
    }

    h1, h2, h3, h4 {
      line-height: 1.3;
      font-weight: 600;
      color: var(--color-text-primary);
    }

    p { margin: 0; }

    ul, ol { list-style: none; }

    img, svg { display: block; max-width: 100%; }

    button, input, select, textarea {
      font: inherit;
      color: inherit;
    }

    a {
      color: var(--color-accent);
      text-decoration: none;
    }

    a:hover { text-decoration: underline; }

    /* =====================================================================
       3. SKIP LINK
       ===================================================================== */
    .skip-link {
      position: absolute;
      top: -100%;
      left: var(--space-md);
      background: var(--color-skip-bg);
      color: var(--color-text-inverse);
      padding: var(--space-sm) var(--space-md);
      border-radius: var(--radius);
      font-weight: 600;
      z-index: 1000;
      transition: top var(--transition-fast);
    }

    .skip-link:focus {
      top: var(--space-sm);
    }

    /* =====================================================================
       5. HEADER / NAV
       ===================================================================== */
    .app-header {
      background: var(--color-surface);
      border-bottom: 1px solid var(--color-border);
      position: sticky;
      top: 0;
      z-index: 100;
    }

    .header-inner {
      max-width: 1200px;
      margin: 0 auto;
      padding: var(--space-md) var(--space-xl);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-md);
    }

    .app-logo {
      display: flex;
      align-items: center;
      gap: var(--space-sm);
      text-decoration: none;
    }

    .app-logo-icon {
      width: 32px;
      height: 32px;
      flex-shrink: 0;
    }

    .app-logo-text {
      font-size: 1.15rem;
      font-weight: 700;
      color: var(--color-text-primary);
      letter-spacing: -0.01em;
    }

    .app-logo-text span {
      color: var(--color-accent);
    }

    .app-nav {
      display: flex;
      align-items: center;
      gap: var(--space-xl);
    }

    .nav-link {
      font-size: 0.875rem;
      font-weight: 500;
      color: var(--color-text-secondary);
      padding: var(--space-xs) 0;
      border-bottom: 2px solid transparent;
      transition: color var(--transition-fast), border-color var(--transition-fast);
    }

    .nav-link:hover,
    .nav-link.active {
      color: var(--color-accent);
      border-bottom-color: var(--color-accent);
      text-decoration: none;
    }

    .nav-link:focus-visible {
      outline: 2px solid var(--color-border-focus);
      outline-offset: 2px;
      border-radius: var(--radius-sm);
    }

    .nav-badge {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      background: var(--color-accent);
      color: var(--color-text-inverse);
      font-size: 0.7rem;
      font-weight: 700;
      border-radius: var(--radius-pill);
      padding: 1px 6px;
      margin-left: var(--space-xs);
      vertical-align: middle;
    }

    /* =====================================================================
       6. PAGE WRAPPER & MAIN LAYOUT
       ===================================================================== */
    .page-wrapper {
      max-width: 1200px;
      margin: 0 auto;
      padding: var(--space-xl) var(--space-xl) var(--space-2xl);
    }

    .page-intro {
      margin-bottom: var(--space-xl);
    }

    .page-intro h1 {
      font-size: 1.5rem;
      margin-bottom: var(--space-xs);
    }

    .page-intro p {
      color: var(--color-text-secondary);
      font-size: 0.9375rem;
    }

    .main-layout {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--space-lg);
      align-items: start;
      margin-bottom: var(--space-lg);
    }

    /* =====================================================================
       7. PANEL BASE
       ===================================================================== */
    .panel {
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-lg);
      padding: var(--space-lg);
      box-shadow: var(--shadow-sm);
    }

    .panel-header {
      display: flex;
      align-items: center;
      gap: var(--space-sm);
      margin-bottom: var(--space-lg);
      padding-bottom: var(--space-md);
      border-bottom: 1px solid var(--color-border);
    }

    .panel-icon {
      width: 20px;
      height: 20px;
      color: var(--color-accent);
      flex-shrink: 0;
    }

    .panel-title {
      font-size: 1rem;
      font-weight: 600;
    }

    /* =====================================================================
       8. INPUT SECTION
       ===================================================================== */
    .form-group {
      margin-bottom: var(--space-lg);
    }

    .form-label {
      display: block;
      font-size: 0.875rem;
      font-weight: 600;
      color: var(--color-text-primary);
      margin-bottom: var(--space-sm);
    }

    .form-label .required {
      color: var(--color-negative);
      margin-left: 2px;
    }

    .form-textarea {
      width: 100%;
      border: 1px solid var(--color-border);
      border-radius: var(--radius);
      padding: var(--space-md);
      font-size: 0.9375rem;
      line-height: 1.6;
      resize: vertical;
      min-height: 140px;
      background: var(--color-surface);
      color: var(--color-text-primary);
      transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
    }

    .form-textarea::placeholder {
      color: var(--color-text-secondary);
    }

    .form-textarea:hover {
      border-color: #adb5bd;
    }

    .form-textarea:focus {
      outline: none;
      border-color: var(--color-border-focus);
      box-shadow: 0 0 0 3px rgba(13,110,253,0.18);
    }

    .form-hint {
      margin-top: var(--space-xs);
      font-size: 0.8125rem;
      color: var(--color-text-secondary);
    }

    /* Category radio pills */
    .category-fieldset {
      border: none;
    }

    .category-legend {
      font-size: 0.875rem;
      font-weight: 600;
      color: var(--color-text-primary);
      margin-bottom: var(--space-sm);
      float: left;
      width: 100%;
    }

    .category-options {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-sm);
    }

    .category-options input[type="radio"] {
      position: absolute;
      opacity: 0;
      width: 0;
      height: 0;
      pointer-events: none;
    }

    .category-options label {
      display: inline-flex;
      align-items: center;
      gap: var(--space-xs);
      padding: var(--space-xs) var(--space-md);
      border: 1.5px solid var(--color-border);
      border-radius: var(--radius-pill);
      font-size: 0.875rem;
      font-weight: 500;
      color: var(--color-text-secondary);
      background: var(--color-surface);
      cursor: pointer;
      transition: border-color var(--transition-fast), background var(--transition-fast), color var(--transition-fast);
      user-select: none;
    }

    .category-options label:hover {
      border-color: var(--color-accent);
      color: var(--color-accent);
      background: rgba(13,110,253,0.05);
    }

    .category-options input[type="radio"]:checked + label {
      border-color: var(--color-accent);
      background: var(--color-accent);
      color: var(--color-text-inverse);
    }

    .category-options input[type="radio"]:focus-visible + label {
      outline: 2px solid var(--color-border-focus);
      outline-offset: 2px;
    }

    /* Demo trigger labels */
    .demo-triggers {
      margin-top: var(--space-lg);
      padding-top: var(--space-lg);
      border-top: 1px solid var(--color-border);
    }

    .demo-triggers-label {
      font-size: 0.8125rem;
      font-weight: 600;
      color: var(--color-text-secondary);
      text-transform: uppercase;
      letter-spacing: 0.05em;
      margin-bottom: var(--space-sm);
    }

    .demo-trigger-row {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-sm);
    }

    .demo-trigger {
      display: inline-flex;
      align-items: center;
      gap: var(--space-xs);
      padding: var(--space-xs) var(--space-md);
      border-radius: var(--radius-pill);
      font-size: 0.8125rem;
      font-weight: 600;
      cursor: pointer;
      border: 1.5px solid;
      transition: opacity var(--transition-fast), transform var(--transition-fast);
      user-select: none;
    }

    .demo-trigger:hover { opacity: 0.85; }
    .demo-trigger:active { transform: translateY(1px); }

    .demo-trigger.positive {
      background: var(--color-positive-bg);
      color: var(--color-positive-text);
      border-color: var(--color-positive);
    }

    .demo-trigger.neutral {
      background: var(--color-neutral-bg);
      color: var(--color-neutral-text);
      border-color: var(--color-neutral);
    }

    .demo-trigger.negative {
      background: var(--color-negative-bg);
      color: var(--color-negative-text);
      border-color: var(--color-negative);
    }

    .demo-trigger:focus-visible {
      outline: 2px solid var(--color-border-focus);
      outline-offset: 2px;
    }

    /* Submit button */
    .btn-analyze {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: var(--space-sm);
      width: 100%;
      padding: 12px var(--space-lg);
      background: var(--color-accent);
      color: var(--color-text-inverse);
      border: none;
      border-radius: var(--radius);
      font-size: 0.9375rem;
      font-weight: 600;
      cursor: pointer;
      transition: background var(--transition-fast), transform var(--transition-fast), box-shadow var(--transition-fast);
      margin-top: var(--space-lg);
    }

    .btn-analyze:hover {
      background: var(--color-accent-hover);
      box-shadow: 0 4px 12px rgba(13,110,253,0.3);
    }

    .btn-analyze:active {
      background: var(--color-accent-active);
      transform: translateY(1px);
      box-shadow: none;
    }

    .btn-analyze:focus-visible {
      outline: 2px solid var(--color-border-focus);
      outline-offset: 3px;
    }

    /* =====================================================================
       9. RESULTS SECTION
       ===================================================================== */
    .results-panel {
      min-height: 420px;
    }

    /* Empty state */
    .result-empty {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      min-height: 280px;
      gap: var(--space-md);
      color: var(--color-text-secondary);
      text-align: center;
    }

    .result-empty-icon {
      width: 48px;
      height: 48px;
      opacity: 0.35;
    }

    .result-empty p {
      font-size: 0.9375rem;
      max-width: 220px;
      line-height: 1.5;
    }

    /* Result card */
    .result-card {
      display: none;
      animation: fadeIn 0.3s ease;
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(6px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    /* Sentiment badge */
    .sentiment-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: var(--space-lg);
      flex-wrap: wrap;
      gap: var(--space-sm);
    }

    .sentiment-badge {
      display: inline-flex;
      align-items: center;
      gap: var(--space-xs);
      padding: var(--space-xs) var(--space-md);
      border-radius: var(--radius-pill);
      font-size: 0.8125rem;
      font-weight: 700;
      letter-spacing: 0.04em;
      text-transform: uppercase;
    }

    .sentiment-badge.positive {
      background: var(--color-positive-bg);
      color: var(--color-positive-text);
    }

    .sentiment-badge.neutral {
      background: var(--color-neutral-bg);
      color: var(--color-neutral-text);
    }

    .sentiment-badge.negative {
      background: var(--color-negative-bg);
      color: var(--color-negative-text);
    }

    .sentiment-dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      display: inline-block;
      flex-shrink: 0;
    }

    .positive .sentiment-dot  { background: var(--color-positive); }
    .neutral  .sentiment-dot  { background: var(--color-neutral); }
    .negative .sentiment-dot  { background: var(--color-negative); }

    .result-scenario {
      font-size: 0.8125rem;
      color: var(--color-text-secondary);
      font-style: italic;
    }

    /* Confidence score */
    .result-section {
      margin-bottom: var(--space-lg);
    }

    .result-section-label {
      font-size: 0.8125rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--color-text-secondary);
      margin-bottom: var(--space-sm);
    }

    .score-row {
      display: flex;
      align-items: center;
      gap: var(--space-md);
    }

    .score-bar {
      flex: 1;
      height: 10px;
      background: var(--color-border);
      border-radius: var(--radius-pill);
      overflow: hidden;
    }

    .score-fill {
      height: 100%;
      border-radius: var(--radius-pill);
      transition: width 0.5s ease;
    }

    .positive .score-fill  { background: var(--color-positive); }
    .neutral  .score-fill  { background: var(--color-neutral); }
    .negative .score-fill  { background: var(--color-negative); }

    .score-value {
      font-size: 0.9375rem;
      font-weight: 700;
      min-width: 38px;
      text-align: right;
    }

    .positive .score-value  { color: var(--color-positive); }
    .neutral  .score-value  { color: var(--color-neutral); }
    .negative .score-value  { color: var(--color-negative); }

    /* Key topics */
    .topics-list {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-sm);
    }

    .topic-pill {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      padding: 3px 10px;
      background: var(--color-bg);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-pill);
      font-size: 0.8125rem;
      font-weight: 500;
      color: var(--color-text-primary);
    }

    .topic-pill-dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--color-accent);
      flex-shrink: 0;
    }

    /* Analysis summary */
    .summary-text {
      font-size: 0.9375rem;
      line-height: 1.7;
      color: var(--color-text-primary);
      background: var(--color-bg);
      border-left: 3px solid var(--color-border);
      padding: var(--space-md);
      border-radius: 0 var(--radius) var(--radius) 0;
    }

    /* =====================================================================
       10. STATE CLASSES — toggled by JavaScript (real API-driven results)
       ===================================================================== */

    /* Show active result card */
    .result-card.active {
      display: block;
    }

    /* Hide empty state when a result is active */
    .results-panel.has-result .result-empty {
      display: none;
    }

    /* Highlight active demo trigger */
    .demo-trigger.active {
      box-shadow: 0 0 0 3px rgba(13,110,253,0.25);
    }

    /* Loading state for the results panel */
    .result-loading {
      display: none;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      min-height: 280px;
      gap: var(--space-md);
      color: var(--color-text-secondary);
      text-align: center;
    }

    .results-panel.is-loading .result-loading {
      display: flex;
    }

    .results-panel.is-loading .result-empty,
    .results-panel.is-loading .result-card {
      display: none;
    }

    .spinner {
      width: 32px;
      height: 32px;
      border: 3px solid var(--color-border);
      border-top-color: var(--color-accent);
      border-radius: 50%;
      animation: spin 0.8s linear infinite;
    }

    @keyframes spin {
      to { transform: rotate(360deg); }
    }

    /* Error banner */
    .result-error {
      display: none;
      background: var(--color-negative-bg);
      color: var(--color-negative-text);
      border: 1px solid var(--color-negative);
      border-radius: var(--radius);
      padding: var(--space-md);
      font-size: 0.875rem;
      margin-bottom: var(--space-md);
    }

    .result-error.visible { display: block; }

    .form-error {
      display: none;
      color: var(--color-negative);
      font-size: 0.8125rem;
      margin-top: var(--space-xs);
    }

    .form-error.visible { display: block; }

    .form-textarea.invalid {
      border-color: var(--color-negative);
    }

    .demo-text-positive,
    .demo-text-neutral,
    .demo-text-negative {
      display: none;
    }

    /* =====================================================================
       11. HISTORY SECTION
       ===================================================================== */
    .history-section {
      margin-top: var(--space-sm);
    }

    .history-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: var(--space-sm);
      margin-bottom: var(--space-lg);
      padding-bottom: var(--space-md);
      border-bottom: 1px solid var(--color-border);
    }

    .history-title-row {
      display: flex;
      align-items: center;
      gap: var(--space-sm);
    }

    .history-count {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      background: var(--color-bg);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-pill);
      font-size: 0.75rem;
      font-weight: 700;
      color: var(--color-text-secondary);
      padding: 1px 8px;
    }

    .table-scroll {
      overflow-x: auto;
      border-radius: var(--radius);
      border: 1px solid var(--color-border);
    }

    .history-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.875rem;
    }

    .history-table thead tr {
      background: var(--color-bg);
    }

    .history-table th {
      padding: 10px var(--space-md);
      text-align: left;
      font-size: 0.75rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--color-text-secondary);
      border-bottom: 1px solid var(--color-border);
      white-space: nowrap;
    }

    .history-table td {
      padding: 12px var(--space-md);
      border-bottom: 1px solid var(--color-border);
      vertical-align: middle;
      color: var(--color-text-primary);
    }

    .history-table tbody tr:last-child td {
      border-bottom: none;
    }

    .history-table tbody tr:nth-child(even) {
      background: var(--color-row-stripe);
    }

    .history-table tbody tr:hover {
      background: var(--color-row-hover);
    }

    .td-date {
      white-space: nowrap;
      color: var(--color-text-secondary);
      font-size: 0.8125rem;
    }

    .td-category {
      white-space: nowrap;
    }

    .category-tag {
      display: inline-block;
      background: var(--color-bg);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-sm);
      padding: 1px 7px;
      font-size: 0.75rem;
      font-weight: 600;
      color: var(--color-text-secondary);
    }

    .td-feedback {
      max-width: 300px;
    }

    .feedback-preview {
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
      color: var(--color-text-primary);
    }

    .td-confidence {
      white-space: nowrap;
    }

    .mini-score-wrap {
      display: flex;
      align-items: center;
      gap: var(--space-sm);
    }

    .mini-bar {
      width: 60px;
      height: 6px;
      background: var(--color-border);
      border-radius: var(--radius-pill);
      overflow: hidden;
      flex-shrink: 0;
    }

    .mini-fill {
      height: 100%;
      border-radius: var(--radius-pill);
    }

    .mini-fill.positive { background: var(--color-positive); }
    .mini-fill.neutral  { background: var(--color-neutral); }
    .mini-fill.negative { background: var(--color-negative); }

    .mini-pct {
      font-size: 0.8125rem;
      font-weight: 600;
    }

    .mini-pct.positive { color: var(--color-positive); }
    .mini-pct.neutral  { color: var(--color-neutral); }
    .mini-pct.negative { color: var(--color-negative); }

    /* =====================================================================
       12. FOOTER
       ===================================================================== */
    .app-footer {
      margin-top: var(--space-2xl);
      padding: var(--space-lg) var(--space-xl);
      border-top: 1px solid var(--color-border);
      text-align: center;
      font-size: 0.8125rem;
      color: var(--color-text-secondary);
    }

    /* =====================================================================
       13. RESPONSIVE
       ===================================================================== */
    @media (max-width: 900px) {
      .main-layout {
        grid-template-columns: 1fr;
      }

      .results-panel {
        min-height: auto;
      }
    }

    @media (max-width: 768px) {
      .header-inner {
        padding: var(--space-md);
      }

